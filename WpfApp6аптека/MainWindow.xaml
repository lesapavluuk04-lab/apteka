<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека — Вход в систему"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- МЯГКИЙ ГРАДИЕНТНЫЙ ФОН ОКНА (Мятный) -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F5E9" Offset="0.0" />
            <GradientStop Color="#C8E6C9" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- Контейнер по центру -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- ЛОГОТИП (Круг с объемной тенью и градиентом) -->
            <Border Width="180" Height="180"
                    CornerRadius="90"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <!-- Отрицательный отступ, чтобы форма заехала под круг -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#66BB6A" Offset="0.0" />
                        <GradientStop Color="#2E7D32" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#1B5E20" BlurRadius="25" ShadowDepth="6" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="АПТЕКА"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="«ЧУДЕС»"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#C8E6C9"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- БЕЛАЯ КАРТОЧКА ВХОДА -->
            <Border Width="420"
                    Background="White"
                    CornerRadius="15"
                    Padding="40,30,40,30">
                <Border.Effect>
                    <DropShadowEffect Color="#1B5E20" BlurRadius="40" ShadowDepth="10" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Заголовок -->
                    <TextBlock Text="Вход в систему"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#1B5E20"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- Логин -->
                    <TextBlock Text="Логин" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                        <TextBox x:Name="txtLogin"
                                 Height="40" FontSize="15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Border>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,25">
                        <PasswordBox x:Name="txtPassword"
                                     Height="40" FontSize="15"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                    </Border>

                    <!-- Кнопка Войти -->
                    <Button Content="ВОЙТИ"
                            Height="45" FontSize="16" FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#2E7D32" x:Name="btnBorder">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2E7D32" BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#43A047"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Статус ошибки -->
                    <TextBlock x:Name="lblStatus"
                               FontSize="13" Foreground="#D32F2F"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>