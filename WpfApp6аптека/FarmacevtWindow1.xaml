<Window x:Class="WpfApp.FarmacevtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека — Фармацевт-кассир"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <!-- ЗЕЛЕНЫЙ ГРАДИЕНТНЫЙ ФОН -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F5E9" Offset="0.0" />
            <GradientStop Color="#C8E6C9" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Кнопки -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="#2E7D32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки -->
        <Style x:Key="ModernHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ★ СТРОКИ: Максимально четкие, без теней и анимаций ★ -->
        <Style x:Key="ModernRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F1F8E9"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A5D6A7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль таблицы -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource ModernRowStyle}"/>

            <!-- ★ ВОТ ОНА, МАГИЯ ЧЕТКОСТИ ★ -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2E7D32" Offset="0.0" />
                   
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblWelcome"
                           Text="Фармацевт-кассир"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="25,0,0,0"/>
                <Button Grid.Column="1" Content="Выйти"
                        Width="100" Height="36"
                        Margin="0,0,25,0"
                        Background="#1B5E20" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: ТОВАРЫ (БЕЗ ТЕНИ ПАНЕЛИ) -->
            <Border Grid.Column="0" Background="#A5D6A7" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid Margin="15">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="lblExpiredInfo"
           Grid.Column="0"
           Text=""
           FontSize="13"
           Foreground="#B71C1C"
           FontWeight="Bold"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"
           Margin="0,0,20,0"/>

                        <TextBox Grid.Column="0" x:Name="txtSearch"
                                 Height="36" Padding="10,5" FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1" Content="Найти"
                                Style="{StaticResource PillButton}"
                                Width="100" Height="36"
                                Margin="10,0,0,0"
                                Click="BtnSearch_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgProducts"
          Style="{StaticResource ModernDataGridStyle}"
          FocusVisualStyle="{x:Null}"
          MouseDoubleClick="DgProducts_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Наим-ние" Binding="{Binding Наименование}" Width="*"/>
                            <DataGridTextColumn Header="МНН" Binding="{Binding МНН}" Width="*"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} ₽}" Width="*"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Остаток}" Width="*"/>
                            <DataGridTextColumn Header="Срокгд" Binding="{Binding СрокГодностиText}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Статус}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: КОРЗИНА (БЕЗ ТЕНИ ПАНЕЛИ) -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Корзина"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#1B5E20"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="dgCart"
                              Style="{StaticResource ModernDataGridStyle}"
                              FocusVisualStyle="{x:Null}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Наименование}" Width="2*"/>
                            <DataGridTextColumn Header="Кол" Binding="{Binding Количество}" Width="*"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} ₽}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Удалить" Width="100" Height="32"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnRemove_Click"/>
                        <Button Content="Очистить" Width="100" Height="32"
                                Margin="10,0,0,0"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnClear_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Скидка:" FontSize="14" Foreground="#555" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbDiscount" Width="170" Height="30" SelectionChanged="CmbDiscount_SelectionChanged">
                                <ComboBoxItem Content="Без скидки" Tag="0"/>
                                <ComboBoxItem Content="Пенсионерам (10%)" Tag="0,1"/>
                                <ComboBoxItem Content="Карта лояльности (5%)" Tag="0,05"/>
                                <ComboBoxItem Content="Сотрудникам (15%)" Tag="0,15"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Оплата:" FontSize="14" Foreground="#555" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbPayment" Width="170" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Наличные"/>
                                <ComboBoxItem Content="Карта"/>
                                <ComboBoxItem Content="QR-код"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Итого к оплате:" FontSize="14" Foreground="#555" Margin="0,5,0,0"/>
                        <TextBlock x:Name="lblTotal" Text="0,00 ₽" FontSize="26" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,10"/>

                        <Button Content="Оформить продажу"
                                Height="45" FontSize="16" FontWeight="Bold"
                                Background="#1B5E20" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnCheckout_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>