<Window x:Class="WpfApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека — Администратор"
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">

    <!-- ЗЕЛЕНЫЙ ГРАДИЕНТНЫЙ ФОН -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F5E9" Offset="0.0" />
            <GradientStop Color="#C8E6C9" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="21" x:Name="border" Background="#2E7D32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="#00C853">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ★ ЧЕТКИЕ СТРОКИ ДЛЯ АДМИНА ★ -->
        <Style x:Key="ModernRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Style.Triggers>
                <!-- Чередование цветов -->
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F1F8E9"/>
                </Trigger>
                <!-- Наведение -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <!-- Выделение -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A5D6A7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>

                <!-- ★ ПРОСРОЧЕНО (Красный) ★ -->
                <DataTrigger Binding="{Binding Просрочен}" Value="True">
                    <Setter Property="Background" Value="#FFCDD2"/>
                    <Setter Property="Foreground" Value="#B71C1C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

                <!-- ★ Скоро истекает (Желтый) ★ -->
                <DataTrigger Binding="{Binding СкороИстекает}" Value="True">
                    <Setter Property="Background" Value="#FFF9C4"/>
                    <Setter Property="Foreground" Value="#827717"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource ModernRowStyle}"/>

            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Background="#2E7D32">
            <Grid>
                <TextBlock x:Name="lblWelcome" Text="Администратор" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="25,0,0,0"/>
                <Button Content="Выйти" Width="100" Height="36" Margin="0,0,25,0" HorizontalAlignment="Right" Cursor="Hand" Click="BtnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="#1B5E20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- МЕНЮ -->
        <Border Grid.Row="1" Background="#A5D6A7" Padding="15,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Товары" Style="{StaticResource PillButton}" Click="BtnTovary_Click" Width="90"/>
                    <Button Content="Цены" Style="{StaticResource PillButton}" Click="BtnCeny_Click" Width="90"/>
                    <Button Content="Персонал" Style="{StaticResource PillButton}" Click="BtnPersonal_Click" Width="90"/>
                    <Button Content="Поставки" Style="{StaticResource PillButton}" Click="BtnPostavki_Click" Width="90"/>
                    <Button Content="Продажи" Style="{StaticResource PillButton}" Click="BtnProdazhi_Click" Width="90"/>
                    <Button Content="Отчёты" Style="{StaticResource PillButton}" Click="BtnOtcety_Click" Width="90"/>
                </StackPanel>
                <Button x:Name="btnAdd" Content=" Добавить" Style="{StaticResource AddButton}" Click="BtnAdd_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ ДОБАВЛЕНИЯ -->
        <Border Grid.Row="2" x:Name="pnlForm" Background="White" Padding="20,15" BorderBrush="#1B5E20" BorderThickness="0,0,0,3" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="lblFormTitle" Text="Добавить запись" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,15"/>
                <StackPanel x:Name="pnlFields" Orientation="Horizontal" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content=" Сохранить" Width="130" Height="36" Margin="0,0,10,0" Cursor="Hand" Click="BtnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="#1B5E20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content=" Отмена" Width="110" Height="36" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="#78909C">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ТАБЛИЦА -->
        <Border Grid.Row="3" Background="#A5D6A7" Padding="20,10" Margin="15" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и счетчик просрочки -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblTitle" Text="Выберите раздел" FontSize="22" FontWeight="Bold" Foreground="#1B5E20"/>
                    <TextBlock Grid.Column="1" x:Name="lblExpiredInfo" Text="" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgData" 
                          Style="{StaticResource ModernDataGridStyle}"
                          AutoGenerateColumns="True" 
                          IsReadOnly="True" 
                          CanUserAddRows="False" 
                          SelectionUnit="FullRow" 
                          SelectionMode="Single" 
                          FocusVisualStyle="{x:Null}"
                          MouseDoubleClick="DgData_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X" Width="28" Height="28" 
                                            Background="#1B5E20" Foreground="White" FontWeight="Bold" 
                                            BorderThickness="0" Cursor="Hand" 
                                            Click="BtnDeleteRow_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="14" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>